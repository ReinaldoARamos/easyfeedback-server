datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  photo     String?
  createdAt DateTime @default(now())

  // Relação com Feedback
  feedbacks Feedback[]
}

model Feedback {
  id            Int      @id @default(autoincrement())
  comment       String
  createdAt     DateTime @default(now())
  likesCount    Int      @default(0)
  feedbackTitle String   @default("Sem título")
  userRating    Int      @default(0)

  // Relação com User
  userId Int
  user   User @relation(fields: [userId], references: [id])
}
